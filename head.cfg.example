# EH3D-NODE-BUNGARD-AUX settings: one key = value per line. Copy to head.cfg in the config partition. A value out of range is reported and the default stays.

# the link (empty address: DHCP). The token is needed to measure and to see the camera; without a token the node only answers /api/status.
name = bungard-aux
address =
port = 80
token =

# the camera of the head (MJPEG on /stream): camera_model is auto, ov2640 or ov5640; the size is the largest one that the sensor can do and that is not larger than width x height
camera_enabled = on
camera_model = auto
camera_width = 640
camera_height = 480
camera_quality = 12
camera_fps_max = 10
# the picture: mirror, upside down, brightness / contrast / saturation (-2 to 2), automatic exposure (or by hand, 0 to 1200) and automatic white balance
camera_hmirror = no
camera_vflip = no
camera_brightness = 0
camera_contrast = 0
camera_saturation = 0
camera_auto_exposure = yes
camera_exposure = 300
camera_auto_whitebalance = yes

# the video as an IP camera sends it: RTSP (rtsp://ADDRESS:PORT/stream1) and ONVIF; both log in with this user and password, and without a password nothing is served
rtsp_enabled = on
rtsp_port = 554
onvif_enabled = on
stream_user = viewer
stream_password =

# the laser that measures the table: readings per measure (the median is taken), the offset of the sensor above the tool tip, the range it trusts
laser_enabled = on
laser_samples = 7
laser_timeout_ms = 1500
laser_offset_mm = 0
laser_range_min_mm = 20
laser_range_max_mm = 400
laser_sigma_max_mm = 0.15
# how the sensor looks: short (to about 1.3 m, less trouble with light) or long (to about 4 m, best in the dark); the time it looks for each reading (short 15, 20, 33, 50, 100, 200 or 500 ms; long the same without 15)
laser_distance_mode = long
laser_timing_budget_ms = 100
# the area of the receiving array that looks at the table (WxH, each side 4 to 16) and the detector it is centred on (0: the centre the sensor reports)
laser_roi = 16x16
laser_roi_center = 0
# a reading farther than this many spreads from the median is thrown away (1 to 10); the spread is never taken smaller than the floor (mm, 0.01 to 1)
laser_outlier_k = 3
laser_outlier_floor_mm = 0.05
# the calibration at a known distance changes what every reading means: off until an administrator switches it on; the two values it finds are stored here
laser_calibration_enabled = off
laser_cal_offset_mm = 0
laser_cal_xtalk_cps = 0

# the speed of the spindle: pulses of the sensor per turn, the speed that counts as an alarm, how long without a pulse means stopped
rpm_enabled = on
rpm_pulses_per_rev = 1
# the input of the sensor: digital (the output DO of the module, on an interrupt) or analog (the output AO, read by a fast ADC with a Schmitt trigger; pin AUX_RPM_ANALOG_GPIO), and the edge that is a pulse
rpm_input = digital
rpm_edge = rising
# analog input: the thresholds follow the signal (35 % and 65 % between its extremes), or these two levels in mV
rpm_auto_threshold = yes
rpm_threshold_hi_mv = 2000
rpm_threshold_lo_mv = 1000
rpm_max = 65000
rpm_stale_ms = 1500

# the temperature of the spindle: none, ds18b20, ntc or mlx90614
temp_sensor = none
# the DS18B20: its resolution (9, 10, 11 or 12 bits; a conversion takes 94 to 750 ms) and which sensor of the wire is the spindle's: auto (the only one, or the first found) or the 16 hex digits of its address (the status page lists them)
temp_resolution = 12
temp_rom = auto
# the thermistor when temp_sensor = ntc: the resistor of the divider, the resistance at 25 degrees and the beta of the data sheet
ntc_series_ohm = 10000
ntc_r25_ohm = 10000
ntc_beta = 3950
temp_warn_c = 55
temp_critical_c = 70
temp_hysteresis_c = 3

# the ring of LEDs around the camera (eight WS2812 on one wire): the level it starts at, the ceiling it never goes over (0 to 100), the tone (white, cool, warm, red, green or blue), when it turns itself off (seconds, 0: never) and the order of the colours of the LED (grb or rgb)
light_enabled = on
light_leds = 8
light_level = 60
light_max_level = 80
light_tone = white
light_auto_off_s = 600
light_on_at_start = off
light_order = grb

# the protect output opens when the spindle is too fast or too hot (a sensor that is on and silent counts as hot)
protect_output = on

# the self-check: the node judges its own status and says it with codes in /api/status (selfcheck, selfcheck_codes); a laser reading older than this many seconds is reported, and for this many seconds after the start a reading that is not there yet is not a fault
selfcheck_enabled = on
selfcheck_laser_age_max_s = 600
selfcheck_grace_s = 30
